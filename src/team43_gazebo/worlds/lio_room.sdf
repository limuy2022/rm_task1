<?xml version="1.0"?>
<!-- 最小三维定位场景：悬浮的刚性传感器平台，运动由力/力矩驱动。
     不模拟轮胎、悬架或 MID360 的非重复扫描。所有几何由本文件定义。 -->
<sdf version="1.8">
  <world name="lio_room">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0.5</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0.7 0.7 0.7 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.2 -0.4 -1</direction>
    </light>
    <model name="blender_scene">
      <!-- 必须设为 static，否则整个房间会受重力掉下去 -->
      <static>true</static> 
      <pose>0 0 0 0 0 0</pose>
      
      <link name="scene_link">
        <!-- 碰撞体：雷达扫到点云和物理碰撞全靠它 -->
        <collision name="scene_collision">
          <geometry>
            <mesh>
              <!-- 从已安装的 ROS 包加载，另存 world.sdf 后仍使用同一模型。 -->
              <uri>package://team43_gazebo/meshes/scene.stl</uri>
              <scale>0.3 0.3 0.3</scale>
              <!-- 如果尺寸不对，可以在这里缩放，例如 <scale>1 1 1</scale> -->
            </mesh>
          </geometry>
        </collision>

        <!-- 视觉体：你眼睛看到的贴图和颜色全靠它 -->
        <visual name="scene_visual">
          <geometry>
            <mesh>
              <!-- 路径必须和 collision 完全一致 -->
              <uri>package://team43_gazebo/meshes/scene.stl</uri>
              <scale>0.3 0.3 0.3</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="lidar_rig">
      <pose>0 0 0.7 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="body_visual"><geometry><box><size>0.1 0.1 0.05</size></box></geometry></visual>
        <sensor name="imu" type="imu">
          <always_on>true</always_on><update_rate>200</update_rate>
          <topic>/sim/gazebo/imu</topic>
        </sensor>
        <sensor name="lidar" type="gpu_lidar">
          <!-- 实际平移在运行时从 Point-LIO 的 extrinsic_T 填入。 -->
          <pose>-0.011 -0.02329 0.04412 0 0 0</pose>
          <always_on>true</always_on><update_rate>40</update_rate>
          <topic>/sim/gazebo/lidar</topic>
          <lidar>
            <scan>
              <horizontal><samples>180</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
              <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.65</min_angle><max_angle>0.65</max_angle></vertical>
            </scan>
            <range><min>0.5</min><max>15</max><resolution>0.005</resolution></range>
          </lidar>
        </sensor>
      </link>
      <plugin filename="librm_task1_force_controller.so" name="rm_task1::ForceController"/>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>false</publish_link_pose><publish_sensor_pose>false</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose><publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>100</update_frequency>
      </plugin>
    </model>
  </world>
</sdf>
