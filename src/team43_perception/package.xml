<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>team43_perception</name>
  <version>1.0.0</version>
  <description>marker_corners + camera_info -> solvePnP -> camera_optical_frame 下目标点与各向异性噪声。</description>
  <maintainer email="team@example.com">gimbal_tracker_team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <exec_depend>ament_index_python</exec_depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>team43_common</depend>
  <depend>team43_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
